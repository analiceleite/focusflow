// firestore.rules
// Copie e cole no Console Firebase > Firestore Database > Rules

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Activity Types: cada usuário acessa apenas os seus
    match /activityTypes/{docId} {
      allow read, write: if request.auth != null
        && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId;
    }

    // Presets: cada usuário acessa apenas os seus
    match /presets/{docId} {
      allow read, write: if request.auth != null
        && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId;
    }

    // Sessions: cada usuário acessa apenas as suas
    match /sessions/{docId} {
      allow read, write: if request.auth != null
        && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId;
    }

    // UserMeta: controle de seed de dados iniciais
    match /userMeta/{userId} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId;
    }

    // TimerSessions: sincronização realtime de timers ativos entre dispositivos
    match /timerSessions/{userId} {
      // READ: qualquer device do usuário pode ler o estado do timer
      allow read: if request.auth != null
        && request.auth.uid == userId;
      
      // CREATE: iniciar novo timer
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.userId == userId
        && request.resource.data.initiatedBy is string
        && request.resource.data.timerState is map;
      
      // UPDATE: pausar/parar/sincronizar - qualquer device do usuário pode fazer
      allow update: if request.auth != null
        && request.auth.uid == userId
        && resource.data.userId == userId
        // NÃO permitir mudar initiatedBy após criação
        && request.resource.data.initiatedBy == resource.data.initiatedBy;
      
      // DELETE: qualquer device autenticado do mesmo usuário pode finalizar
      allow delete: if request.auth != null
        && request.auth.uid == userId;
    }
  }
}
